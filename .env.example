# QuantBot 环境变量模板
# 用法: cp .env.example .env
#       然后填写所有 CHANGE_ME 字段
# 注意: .env 不提交到 git（已在 .gitignore 中忽略）

# ── 应用 ──────────────────────────────────────────────────────
ENVIRONMENT=development       # development | staging | production
LOG_LEVEL=INFO

# ── 数据库 (TimescaleDB/PostgreSQL) ──────────────────────────
DB_USER=quantbot
DB_PASSWORD=CHANGE_ME         # 生产环境使用强随机密码
DB_NAME=quantbot
# 注意: Docker Compose 中 DATABASE_URL 由 compose 文件自动组合，无需此处设置
# DATABASE_URL=postgresql+asyncpg://quantbot:CHANGE_ME@localhost:5432/quantbot

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=               # 生产环境建议设置密码
# REDIS_URL 由 compose 文件自动组合

# ── JWT 认证 ──────────────────────────────────────────────────
# 生成命令: openssl rand -hex 32
# 或运行:   make gen-secret
#
# ⚠️ ENVIRONMENT=production 时，下面这个占位值会让**后端直接启动失败**
#    （V3 Wave D-a 起）。这是刻意的：用一个公开已知的串签 JWT，
#    等于任何人都能伪造 admin token —— 一条 WARNING 在容器日志里滚过去
#    拦不住任何人，所以做成了启动即失败。
#    开发/staging 环境不受影响，照旧零配置可启动。
SECRET_KEY=CHANGE_ME_RUN_make_gen-secret

# ── CORS 允许来源 ─────────────────────────────────────────────
# 开发: http://localhost:3000,http://localhost:5173
# 生产: https://quantbot.example.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── 默认账号 ──────────────────────────────────────────────────
# 系统初始化后自动创建:  admin / admin123
# 生产环境务必通过 API 修改密码！
# POST /api/v1/auth/change-password

# ── 美股 Alpaca ───────────────────────────────────────────────
# 申请地址: https://alpaca.markets/
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true             # true=沙盒模式  false=实盘

# ── 港股/美股 富途 OpenD ──────────────────────────────────────
# 需本地运行 OpenD: https://openapi.futunn.com/futu-api-doc/
FUTU_HOST=127.0.0.1
FUTU_PORT=11111
FUTU_TRADE_ENV=SIMULATE       # SIMULATE | REAL
FUTU_UNLOCK_PWD=              # 实盘解锁密码

# ── A 股沪深（akshare，免费，无需 Key）────────────────────────
# akshare 直接使用，无需 API Key

# ── 告警通知（可选）──────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_WEBHOOK_URL=

# ── 期货 CTP（预留，Phase 8）─────────────────────────────────
FUTURES_ENABLED=false
CTP_BROKER_ID=
CTP_INVESTOR_ID=
CTP_PASSWORD=
CTP_TD_ADDRESS=
CTP_MD_ADDRESS=

# ── 监控 ──────────────────────────────────────────────────────
GRAFANA_PASSWORD=CHANGE_ME    # Grafana 管理员密码
GRAFANA_PORT=3001             # Grafana 对外端口
# GRAFANA_DOMAIN=localhost    # 生产环境设置为实际域名

# ── 前端 ──────────────────────────────────────────────────────
# 注意：生产 compose 中前端不再直接对宿主发布端口，统一走下面的边缘反代。
# FRONTEND_PORT 仅 infra/docker-compose.yml（开发）仍在使用。
FRONTEND_PORT=80

# ── 边缘反向代理 / TLS（infra/nginx，详见该目录 README）───────────
HTTP_PORT=80                  # 反代 HTTP 端口（仅用于 ACME 校验与 301 跳转）
HTTPS_PORT=443                # 反代 HTTPS 端口
TLS_CERT_DIR=./nginx/certs    # 证书目录（相对 infra/），需含 fullchain.pem + privkey.pem
                              # ⚠️ 证书不进仓库；生成/续期见 infra/nginx/README.md

# ── 数据库备份（scripts/backup-db.sh，详见 scripts/README.md）─────
QB_BACKUP_DIR=./backups       # 备份产物根目录（已在 .gitignore 中）
QB_BACKUP_KEEP_DAILY=7        # 日备保留份数
QB_BACKUP_KEEP_WEEKLY=4       # 周备保留份数

# ── 用户策略热加载（默认关闭）─────────────────────────────────
#
# ⚠️ 打开后，USER_STRATEGIES_DIR 下的 .py 文件会被**以后端进程的权限执行**。
#    这里没有沙箱，也做不到沙箱（`import os; os.system(...)` 可以藏在任意表达式里）。
#    只放你自己写的或已审阅过的策略，并自行收紧该目录的写权限。
#    平台不提供「策略上传」HTTP 端点 —— 那等于一个远程代码执行漏洞。
USER_STRATEGIES_ENABLED=false
USER_STRATEGIES_DIR=./user_data/strategies
